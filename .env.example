# Supabase Configuration
VITE_SUPABASE_PROJECT_ID=your_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
VITE_SUPABASE_URL=https://your_project_id.supabase.co

# Required for production
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
RESEND_API_KEY=your_resend_api_key

# Instructions:
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual Supabase project details
# 3. Get your Supabase keys from: https://supabase.com/dashboard/project/[project-id]/settings/api
# 4. Get Resend API key from: https://resend.com/api-keys (required for email notifications)
# 5. Never commit .env file to version control